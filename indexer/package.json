{
  "name": "rental-event-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "abi:generate": "node --no-use-env-proxy scripts/abi.mjs",
    "abi:check": "node --no-use-env-proxy scripts/abi.mjs --check",
    "dev": "node --no-use-env-proxy scripts/start.mjs",
    "test": "node --no-use-env-proxy --experimental-strip-types --test tests/unit.test.ts",
    "test:acceptance": "node --no-use-env-proxy --experimental-strip-types tests/acceptance.ts",
    "demo": "node --no-use-env-proxy --experimental-strip-types tests/acceptance.ts --demo",
    "reconcile": "node --no-use-env-proxy --experimental-strip-types scripts/reconcile.ts",
    "format:check": "prettier --check ponder.config.ts ponder.schema.ts shared src scripts tests"
  },
  "dependencies": {
    "hono": "4.13.13",
    "ponder": "0.18.2",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
